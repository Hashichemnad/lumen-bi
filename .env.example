# Copy to .env and change every value marked CHANGE ME before running in production.

# Public address users open in the browser (used for links in emails and SSO callbacks)
PUBLIC_URL=http://localhost:8080
# Domain for automatic HTTPS. Use "localhost" (or ":80") for local runs; a real domain enables Let's Encrypt.
SITE_ADDRESS=:80
# Sites allowed to show embedded dashboards in an iframe, space separated (e.g. https://portal.company.ae)
EMBED_FRAME_ANCESTORS=
HTTP_PORT=8080

# Long random string, e.g. `openssl rand -hex 32`  -- CHANGE ME
SECRET_KEY=change-me
# Key used to encrypt stored connection secrets, e.g. `openssl rand -base64 32`  -- CHANGE ME
ENCRYPTION_KEY=change-me

# First admin account, created on first start only
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Administrator

# PostgreSQL (metadata)
POSTGRES_USER=lumen
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lumen

# Email (password reset, reports). Leave SMTP_HOST empty to print emails to the API log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Lumen BI <no-reply@example.com>
SMTP_TLS=true

# Security
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Secure cookies (automatic when PUBLIC_URL is https)
COOKIE_SECURE=false
# Sign-in attempts per minute from one address (an office behind one address shares it). Each account is
# also locked after MAX_FAILED_LOGINS wrong passwords or codes.
LOGIN_PER_MINUTE=120

# Data
# Schedules ("daily at 06:00") are interpreted in this time zone
TIMEZONE=Asia/Dubai
MAX_UPLOAD_MB=200
SNAPSHOTS_TO_KEEP=3
# Background jobs: celery (default with Docker) | inline (development without Redis)
JOBS_MODE=celery
# Development only: lets API connections reach localhost (tools/fake_sources.py). Keep false on servers.
ALLOW_LOCAL_API_URLS=false

# Query engine
QUERY_MAX_ROWS=50000
EXPORT_MAX_ROWS=1000000
QUERY_TIMEOUT_SECONDS=60
# Memory DuckDB may use for queries, per API worker (there are 4): 4GB suits a 32 GB server.
# Empty = DuckDB's default (80% of RAM per worker). Threads: 0 = all cores.
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=0
# Query result cache: redis (default with Docker) | memory | off
CACHE_BACKEND=redis
CACHE_SECONDS=3600

# AI (models are added in Admin → AI; keys are stored encrypted, not here)
# Requests one person may make per hour, and how long a model may take to answer
AI_HOURLY_LIMIT=60
AI_TIMEOUT_SECONDS=90
# MCP server (Claude and other AI apps): how long sign-ins last
MCP_ACCESS_TOKEN_MINUTES=60
MCP_REFRESH_TOKEN_DAYS=30

# Dashboard PDF/PNG exports: where the renderer opens the app (Docker sets http://web:8081)
# RENDER_BASE_URL=http://localhost:5173
RENDER_TIMEOUT_SECONDS=120
