(app) {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

{$SITE_ADDRESS::80} {
	import app
}

# Internal only (not published): the export renderer in the worker opens dashboards here, whatever the
# public address and HTTPS set-up are
http://:8081 {
	import app
}
