(app) {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Pages may be framed only by Lumen itself, except embedded dashboards, which the sites listed in
	# EMBED_FRAME_ANCESTORS (space separated, e.g. "https://portal.company.ae") may show in an iframe
	@embed path /embed/*
	@notembed not path /embed/*
	header @notembed {
		X-Frame-Options SAMEORIGIN
		Content-Security-Policy "frame-ancestors 'self'"
	}
	header @embed Content-Security-Policy "frame-ancestors 'self' {$EMBED_FRAME_ANCESTORS:}"
}

{$SITE_ADDRESS::80} {
	import app
}

# Internal only (not published): the export renderer in the worker opens dashboards here, whatever the
# public address and HTTPS set-up are
http://:8081 {
	import app
}
